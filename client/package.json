{
    "name": "client",
    "version": "2026.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "serve": "vite preview",
        "clean": "node -e 'fs.rmSync(\"../server/static/vite\", { recursive: true, force: true })'",
        "build:prep": "npm run clean",
        "build": "npm run build:prep && vite build && mv ../server/index.html ../server/templates/index.html",
        "build:ci": "npm run build:prep && npm run vue-tsc && vite build --outDir dist",
        "format": "oxfmt",
        "format:ci": "oxfmt --check",
        "lint": "oxlint --fix --type-aware",
        "lint:ci": "oxlint --type-aware --deny-warnings",
        "vue-tsc": "vue-tsc --noEmit",
        "tsc": "tsc --noEmit",
        "test": "vitest",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@babylonjs/core": "^9.37.1",
        "@babylonjs/havok": "^1.3.14",
        "@babylonjs/materials": "^9.37.1",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/vue-fontawesome": "3.3.3",
        "@planarally/dice": "^0.9.1",
        "@vueuse/core": "^15.0.0",
        "dompurify": "^3.4.18",
        "lodash": "^4.18.1",
        "markdown-it": "^15.0.3",
        "mathjs": "^15.2.0",
        "path-data-polyfill": "^1.0.10",
        "socket.io-client": "^4.8.4",
        "tinycolor2": "^1.6.0",
        "vue": "^3.5.45",
        "vue-draggable-plus": "^0.6.1",
        "vue-i18n": "11.4.23",
        "vue-markdown-render": "^3.0.0",
        "vue-router": "^5.5.1",
        "vue-toastification": "^2.0.0-rc.5"
    },
    "devDependencies": {
        "@esbuild-plugins/esm-externals": "^0.1.2",
        "@intlify/unplugin-vue-i18n": "^11.2.8",
        "@types/lodash": "^4.17.27",
        "@types/tinycolor2": "^1.4.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/coverage-v8": "^5.1.1",
        "bufferutil": "^4.1.0",
        "happy-dom": "^21.0.4",
        "json-schema-to-typescript": "^16.0.0",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "sass-embedded": "^1.108.2",
        "tsrs": "^7.1.0-beta.tsrs3",
        "typescript": "^6.0.3",
        "v-lazy-show": "^0.3.0",
        "vite": "^8.3.8",
        "vite-plugin-ejs": "^2.0.0",
        "vitest": "^5.1.1",
        "vue-tsc": "3.3.14"
    }
}
