{
    "name": "@planarally/mod-api",
    "version": "0.6.0",
    "description": "Types and helpers for PlanarAlly mods.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "files": [
        "dist"
    ],
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        }
    },
    "peerDependencies": {
        "vite": "^8.0.0",
        "vue": "^3.5.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^24.0.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.8"
    }
}
